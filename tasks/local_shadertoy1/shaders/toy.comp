#version 430

layout(local_size_x = 32, local_size_y = 32) in;

layout(binding = 0, rgba8) uniform image2D resultImage;

layout(push_constant) uniform PushConstants {
    vec2 iResolution;
    float iTime;
    vec4 iMouse;
} pc;

#define MAX_STEPS 100
#define MAX_DIST  50.0
#define EPS       0.001

float sdTorus(vec3 p, float R, float r) {
    vec2 q = vec2(length(p.xz) - R, p.y);
    return length(q) - r;
}

float sdPlane(vec3 p, float h) {
    return p.y - h;
}

float map(vec3 p) {
    float torus = sdTorus(p - vec3(0.0, 1.0, 0.0), 1.0, 0.35);
    float plane = sdPlane(p, -0.5);
    return min(torus, plane);
}

vec3 calcNormal(vec3 p) {
    vec2 e = vec2(0.001, 0.0);
    return normalize(vec3(
        map(p + e.xyy) - map(p - e.xyy),
        map(p + e.yxy) - map(p - e.yxy),
        map(p + e.yyx) - map(p - e.yyx)
    ));
}

float raymarch(vec3 ro, vec3 rd) {
    float t = 0.0;
    for (int i = 0; i < MAX_STEPS; i++) {
        vec3 p = ro + rd * t;
        float d = map(p);
        if (d < EPS) return t;
        t += d;
        if (t > MAX_DIST) break;
    }
    return -1.0;
}

float shadow(vec3 p, vec3 lightDir) {
    float t = 0.05;
    for (int i = 0; i < 32; i++) {
        float d = map(p + lightDir * t);
        if (d < 0.001) return 0.2;
        t += d;
        if (t > 10.0) break;
    }
    return 1.0;
}

vec3 shade(vec3 p, vec3 n, vec3 rd) {
    vec3 lightDir = normalize(vec3(0.8, 1.0, 0.5));
    vec3 lightCol = vec3(1.0, 0.95, 0.85);

    float isFloor = step(p.y, -0.49);

    vec3 baseCol;
    if (isFloor > 0.5) {
        float cx = floor(p.x);
        float cz = floor(p.z);
        float check = mod(cx + cz, 2.0);
        baseCol = mix(vec3(0.15), vec3(0.8), check);
    } else {
        baseCol = vec3(0.9, 0.5, 0.2);
    }

    float dif = clamp(dot(n, lightDir), 0.0, 1.0);

    vec3 V = -rd;
    vec3 R = reflect(-lightDir, n);

    float spe = pow(clamp(dot(R, V), 0.0, 1.0), 32.0);
    spe *= step(0.0, dot(n, lightDir));

    float sh = shadow(p + n * 0.01, lightDir);

    vec3 col = baseCol * dif * sh * lightCol;
    col += lightCol * spe * sh * 0.5;
    col += baseCol * 0.1;

    return col;
}

vec3 renderPixel(vec2 fragCoord) {
    vec2 uv = (fragCoord - 0.5 * pc.iResolution.xy) / pc.iResolution.y;

    // glfwGetCursorPos даёт Y сверху вниз, а нам нужно снизу вверх — инвертируем
    vec2 mousePx = vec2(pc.iMouse.x, pc.iResolution.y - pc.iMouse.y);
    vec2 mouse = (mousePx - 0.5 * pc.iResolution.xy) / pc.iResolution.y;

    // Пока левая кнопка мыши не нажата — фиксированный вид
    if (pc.iMouse.z <= 0.0) mouse = vec2(0.0, 0.2);

    float yaw   = mouse.x * 3.0;
    float pitch = clamp(mouse.y * 1.2, -1.0, 1.0);

    float r = 5.0;
    vec3 ro = vec3(r * cos(pitch) * sin(yaw),
                   r * sin(pitch) + 1.0,
                   r * cos(pitch) * cos(yaw));
    vec3 ta = vec3(0.0, 1.0, 0.0);
    vec3 fw = normalize(ta - ro);
    vec3 rt = normalize(cross(vec3(0.0, 1.0, 0.0), fw));
    vec3 up = -cross(fw, rt);
    vec3 rd = normalize(uv.x * rt + uv.y * up + 1.5 * fw);

    vec3 col = mix(vec3(0.5, 0.7, 1.0), vec3(0.1, 0.15, 0.3), uv.y * 0.5 + 0.5);

    float t = raymarch(ro, rd);
    if (t > 0.0) {
        vec3 p = ro + rd * t;
        vec3 n = calcNormal(p);
        col = shade(p, n, rd);
    }

    col = pow(col, vec3(0.4545));
    return col;
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.iResolution.x) || coord.y >= int(pc.iResolution.y))
        return;

    vec3 col = renderPixel(vec2(coord));
    imageStore(resultImage, coord, vec4(col, 1.0));
}
